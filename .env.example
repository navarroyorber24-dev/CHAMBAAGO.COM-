# PostgreSQL connection string from Railway's Postgres service
DATABASE_URL=

# Generate a unique secret (at least 32 characters) for Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app

# Optional public URL used by client-side integrations
NEXT_PUBLIC_APP_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app

# Optional: only required when Stripe payment processing is implemented
STRIPE_SECRET_KEY=

# Set to true only if your PostgreSQL provider requires custom SSL configuration
DATABASE_SSL=false
